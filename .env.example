# Local iOS release builds and TestFlight uploads (#176), see docs/release/testflight.md.
# Copy the variables into your shell profile or a local, gitignored env file and export them before running
# `pnpm ios:build`, `pnpm ios:upload` or `pnpm ios:release`. Never commit real values.

# Apple Developer team ID (10 characters, Membership details in the Apple Developer account).
APPLE_TEAM_ID=

# App Store Connect API key (Users and Access > Integrations > App Store Connect API, role App Manager).
ASC_KEY_ID=
ASC_ISSUER_ID=
# Absolute path to the downloaded AuthKey_<key id>.p8, stored outside the repository (chmod 600).
ASC_KEY_PATH=

# Optional overrides.
# IOS_BUNDLE_IDENTIFIER=
# IOS_BUILD_NUMBER=   (default: UTC YYYYMMDD.HHMM.SS, each part an integer, e.g. 20261020.905.7)
# IOS_BUILD_DIR=      (outside the repository or under apps/mobile/build/)
