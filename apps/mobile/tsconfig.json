{
  "extends": ["./node_modules/expo/tsconfig.base.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["react", "react-native"],
    "customConditions": ["react-native"]
  },
  "include": [
    "app.config.ts",
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e.config.ts",
    "e2e/**/*.ts"
  ],
  "exclude": ["node_modules", "ios", "android"]
}
