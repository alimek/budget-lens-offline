{
  "name": "@budget-lens/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --dev-client --port 8073",
    "ios": "EXPO_NO_TELEMETRY=1 expo run:ios --port 8073",
    "android": "EXPO_NO_TELEMETRY=1 expo run:android --port 8073",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:extract": "i18next-cli extract",
    "export": "EXPO_NO_TELEMETRY=1 expo export",
    "eas": "EXPO_NO_TELEMETRY=1 pnpm dlx eas-cli@25.2.0",
    "eas:build:ios": "EXPO_NO_TELEMETRY=1 pnpm dlx eas-cli@25.2.0 build --platform ios --profile production",
    "eas:submit:ios": "EXPO_NO_TELEMETRY=1 pnpm dlx eas-cli@25.2.0 submit --platform ios --profile production",
    "e2e:ios": "E2E_TELEMETRY_DISABLED=1 e2e run --target ios --output .e2e/ios",
    "e2e:android": "E2E_TELEMETRY_DISABLED=1 e2e run --target android --output .e2e/android"
  },
  "dependencies": {
    "@budget-lens/core": "workspace:*",
    "@expo/metro-runtime": "58.0.14",
    "@expo/ui": "58.0.21",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@rn-primitives/portal": "1.5.2",
    "@rn-primitives/separator": "1.5.2",
    "@rn-primitives/slot": "1.5.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "58.0.16",
    "expo-constants": "58.0.12",
    "expo-dev-client": "58.0.14",
    "expo-font": "58.0.9",
    "expo-linking": "58.0.13",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.24",
    "expo-splash-screen": "58.0.10",
    "expo-symbols": "58.0.4",
    "expo-updates": "58.0.17",
    "i18next": "26.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.1.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.7.0",
    "uniwind": "1.13.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@e2e-dev/mobile": "0.12.3",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "babel-preset-expo": "58.0.18",
    "e2e": "0.21.2",
    "i18next-cli": "1.77.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
