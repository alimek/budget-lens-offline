{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!apps/mobile/src/uniwind-types.d.ts",
      "!packages/db/src/migrations.generated.ts",
      "!packages/db/drizzle/meta"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noEvolvingTypes": "error",
        "noImplicitAnyLet": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noInferrableTypes": "error",
        "noUnusedTemplateLiteral": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useDefaultParameterLast": "error",
        "useNumberNamespace": "error",
        "useTemplate": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react-native",
                      "react-native/**",
                      "react-native-*",
                      "@react-native/**",
                      "@react-native-*/**",
                      "expo",
                      "expo-*",
                      "expo/**",
                      "@expo/**",
                      "next",
                      "next/**",
                      "@next/**",
                      "@supabase/**",
                      "supabase"
                    ],
                    "message": "packages/core must stay pure TypeScript \u2013 no dependencies on React Native/Expo/Next/Supabase."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/**", "!apps/mobile/src/ui/native/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@expo/ui", "@expo/ui/**"],
                    "message": "Keep Expo UI imports inside src/ui/native adapters."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
