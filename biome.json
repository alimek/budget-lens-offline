{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noEvolvingTypes": "error",
        "noImplicitAnyLet": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noInferrableTypes": "error",
        "noUnusedTemplateLiteral": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useDefaultParameterLast": "error",
        "useNumberNamespace": "error",
        "useTemplate": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react-native",
                      "react-native/**",
                      "react-native-*",
                      "@react-native/**",
                      "@react-native-*/**",
                      "expo",
                      "expo-*",
                      "expo/**",
                      "@expo/**",
                      "next",
                      "next/**",
                      "@next/**",
                      "@supabase/**",
                      "supabase"
                    ],
                    "message": "packages/core must stay pure TypeScript – no dependencies on React Native/Expo/Next/Supabase."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Intl": "packages/core formats money without Intl (Hermes on iOS ignores compact notation): use formatMoney/formatMoneyCompact and the CLDR data in money-locale.ts (ADR 0011)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
