<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/aliclaw</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.aliclaw.bl-sync-issue-list</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>date -u +"--- %Y-%m-%dT%H:%M:%SZ $(git rev-parse --short HEAD)"; exec scripts/agents/sync-issue-list.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/aliclaw/bl-logs/sync-issue-list.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/aliclaw/bl-logs/sync-issue-list.log</string>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>WorkingDirectory</key>
	<string>/Users/aliclaw/projects/budget-lens-offline-sync</string>
</dict>
</plist>
