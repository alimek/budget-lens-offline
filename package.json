{
  "name": "budget-lens-offline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "[ \"$EAS_BUILD\" = true ] || lefthook install",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --error-on-warnings . && node scripts/check-machine-agnostic.mjs",
    "format": "biome check --write .",
    "fallow": "fallow",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm fallow",
    "check:licenses": "node scripts/check-licenses.mjs",
    "i18n:extract": "pnpm --filter @budget-lens/mobile i18n:extract",
    "e2e:ios": "pnpm --filter @budget-lens/mobile e2e:ios",
    "e2e:android": "pnpm --filter @budget-lens/mobile e2e:android",
    "eas:build:ios": "pnpm --filter @budget-lens/mobile eas:build:ios",
    "eas:submit:ios": "pnpm --filter @budget-lens/mobile eas:submit:ios"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "fallow": "3.34.1",
    "lefthook": "2.2.2",
    "turbo": "2.11.9"
  }
}
